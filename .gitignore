mapping.json
cache/

# Raw, non-pseudonymized artifacts: real names of living people. Never pushed.
#
# The per-subject files below are the answer key itself. Publishing them means
# publishing a curated dossier on ten named living people -- every passage
# assessing their conduct, gathered in one place and indexed by name. That is
# the exact harm Article 15 tooling is supposed to guard against, and the fact
# that the source archive is public does not undo the aggregation. Release, if
# ever, goes through mapping.json pseudonymization first.
corpus.jsonl
dropped.jsonl
annotations.jsonl
negatives.jsonl
annotations_S*.jsonl
negatives_S*.jsonl
subjects.json
glossary_S*.md
glossary_S*.json
# Run logs and per-subject byproducts. Nothing reads them; the numbers that
# matter are in data/agreement_all.json and the scorecards.
data/agreement_S*.json
data/truncation_S*.txt
data/truncation_log.txt
data/index_manifest.json

# Fetch-planning scaffolding, derived from the archive and regenerated from the
# HTML cache by probe_index.py, score_threads.py and fetch_plan.py. It carries
# corpus content -- 269 thread titles with their rename chains, 513 message
# subjects, and per-month selection rationale naming people who are not data
# subjects -- so it is covered by the same rule as the corpus itself.
data/index_scores.json
data/thread_scores.json
data/fetch_plan.json

data/pass2_*.jsonl
data/annotations_merged.jsonl
data/negatives_merged.jsonl
data/adjudication_S*.jsonl
data/glossary_S*.json
data/scope_S*.json
data/timeline.json
data/reconcile_cache.json
data/audit_*.json
runs/
samples_*.txt
__pycache__/
*.pyc
.venv/
tab/data/

