# Publishable task inputs, built by dsarbench/build_inputs.py. dist/subjects.json
# is the task-facing subset -- identity facts already public in the archive, with
# our `adverse` and `one_liner` characterisations stripped. The negation is needed
# because the `subjects.json` rule above matches at any depth.
!dist/subjects.json
!dist/corpus_manifest.json
!dist/sallow/corpus.jsonl
!dist/sallow/subjects.json
!dist/sallow/devset.jsonl

# Frozen closed key: human gold, verbatim passages, living people. Not published.
data/closed_key.jsonl
data/closed_key_meta.json

# Human review artifacts. These carry verbatim passage text about named living
# people -- the archive directory especially, since it is a full snapshot of a
# review session. Same reason the key itself is not tracked.
data/adjudication_archive/
data/adjudication_*.jsonl
data/adjudication_*.json
data/adjudication_*.csv
*.bak
*.old

# Gold seed: verbatim passages about named living people, same as the key.
# The rules file is prose about the standard and is safe to track.
goldseed/gold.jsonl
goldseed/progress.json
goldseed/seed_emails.json

